<launch>
    <node name="usb_cam_right" pkg="usb_cam" type="usb_cam_node" output="screen" >
        <param name="video_device" value="/dev/video2"/>
        <param name="image_width" value="640" />
        <param name="image_height" value="480" />
        <param name="pixel_format" value="yuyv" />
        <param name="camera_frame_id" value="usb_cam" />
        <param name="io_method" value="mmap"/>
    </node>
    <node name="image_view" pkg="image_view" type="image_view" respawn="false" output="screen">
        <remap from="image" to="/usb_cam_right/image_raw"/>
        <param name="autosize" value="true" />
    </node>
    <node name="detect_delivery_sign_visualization" pkg="image_view" type="image_view" respawn="false" output="screen">
        <remap from="image" to="/delivery_sign_yolo_result"/>
        <param name="autosize" value="true" />
    </node>
    <node name="detect_delivery_sign" pkg="delivery_yolo" type="detect_delivery_sign.py" output="screen"/>
</launch>