<?xml version="1.0" encoding="UTF-8"?>

<launch>
  <!-- <include file="$(find handsfree_ros_imu)/launch/handsfree_imu.launch"/>
  <include file="$(find ublox_gps)/launch/ublox_zed-f9p_base.launch"/>  -->
  <!-- <include file="$(find lanenet)/launch/lanenet_drive_erp42.launch"/> -->
  <include file="$(find lanenet)/launch/lanenet_drive_morai.launch"/>

  <!-- <include file="$(find bev)/launch/bev_converter_erp.launch" /> -->
  <!-- <include file="$(find bev)/launch/bev_converter.launch" /> -->
  
  <node pkg="waypoint_maker" type="waypoint_maker_right_only.py" name="waypoint_maker_right_only" />
  <node pkg="waypoint_maker" type="drawing_path.py" name="drawing_path" />

  <include file="$(find lidar_object_detection)/launch/object_detection_semi.launch" />
  <!-- <node pkg="race" type="serial_control_node" name="serial_control_node" /> -->
  <node pkg="erp_drive_semi" type="wgs84_to_utmk.py" name="wgs84_to_utmk" args="$(arg target)"/>
  <node pkg="erp_drive_semi" type="planner.py" output="screen" name="planner"/>
  <node pkg="erp_drive_semi" type="control2" name="control2" output="screen" args="$(arg target)"/>

</launch>
