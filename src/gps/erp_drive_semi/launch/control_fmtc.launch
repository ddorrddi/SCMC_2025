<?xml version="1.0" encoding="UTF-8"?>

<launch>
  <include file="$(find handsfree_ros_imu)/launch/handsfree_imu.launch"/>
  <include file="$(find ublox_gps)/launch/ublox_zed-f9p_base.launch"/>
  <include file="$(find lanenet)/launch/lanenet_drive_erp42.launch"/>
  
  <node pkg="waypoint_maker" type="waypoint_maker_right_only.py" name="waypoint_maker_right_only" />
  <node pkg="waypoint_maker" type="drawing_path.py" name="drawing_path" />
  <!-- <include file="$(find static_obstacle_detection)/launch/static_obstacle.launch" /> -->

  <!-- <node pkg="race" type="serial_control_node" name="serial_control_node" /> -->
  <node pkg="erp_drive" type="wgs84_to_utmk.py" name="wgs84_to_utmk" args="$(arg target)"/>
  <node pkg="erp_drive" type="planner_fmtc.py" name="planner_fmtc" args="$(arg path)"/>
  <node pkg="erp_drive" type="control_fmtc" name="control_fmtc" output="screen" args="$(arg target)"/>
</launch>
