<?xml version="1.0" encoding="UTF-8"?>

<launch>
  <!-- 모라이 사용 시 주석 바람 -->
  <!-- <include file="$(find handsfree_ros_imu)/launch/handsfree_imu.launch"/> -->
  <!-- <node pkg="race" type="serial_control_node" name="serial_control_node" /> -->
  <!-- <include file="$(find ublox_gps)/launch/ublox_zed-f9p_base.launch"/> -->
  
  <include file="$(find traffic_light)/launch/yolo_traffic_light_morai.launch" />
  <!-- <include file="$(find traffic_light)/launch/yolo_traffic_light.launch" /> -->

  <!-- 어떤 라이다 인지코드를 쓸지 선택 -->
  <include file="$(find lidar_object_detection)/launch/object_detection.launch" />
  <include file="$(find delivery)/launch/delivery.launch" />
  
  <node pkg="erp_drive" type="wgs84_to_utmk.py" name="wgs84_to_utmk" output = "screen" args="$(arg target)"/>
  <node pkg="erp_drive" type="planner.py" name="planner" output="screen" args="$(arg path)"/>
  <node pkg="erp_drive" type="fusion_node.py" name="fusion_node" output="screen" args="$(arg path)"/>
  <node pkg="erp_drive" type="control" name="control" output="screen" args="$(arg target) f"/>

</launch>